#!/bin/bash
# Tell the user, loudly and persistently, that this session has been through
# a hibernation. On a kernel with the drm/ttm bug that meant "reboot before
# doing anything that matters". Ubuntu fixed it in 7.0.0-41, so the dialog now
# says the opposite: keep the session running, so the fix gets tested.
#
# Why it mattered: on Ubuntu kernels 7.0.0-28 .. -38 (see Part 9 of the write-up) every GPU
# buffer swapped out while writing a hibernation image is left on a dangling
# bulk_move cursor after resume. Freeing one and allocating again corrupts the
# TTM LRU; the machine locks up minutes to hours later. A fresh boot has no such
# buffers. Only image creation swaps them out, so this counts
# "PM: hibernation: hibernation entry" lines in the current boot, not restores.
#
#   hibernate-resume-warn          warn if this boot has hibernated at all
#   hibernate-resume-warn --force  warn unconditionally (used by the sleep hook,
#                                  which has already decided a new one happened)
#   hibernate-resume-warn --quiet  print the count and exit 0/1, no UI
#
# Runs as the logged-in user. Needs notify-send; uses zenity when present.
set -u

count() {
    journalctl -b -k --no-pager -o cat 2>/dev/null | grep -c 'PM: hibernation: hibernation entry'
}

MODE=${1:-}
N=$(count)

case "$MODE" in
    --quiet)
        echo "$N"; [ "$N" -gt 0 ] && exit 1 || exit 0 ;;
    --force) ;;
    *)
        if [ "$N" -eq 0 ]; then
            echo "This boot has not hibernated -- nothing to warn about."
            exit 0
        fi ;;
esac

# Since 7.0.0-41 Ubuntu's kernel carries the fix, and the fix needs testing:
# the session has to keep running after a resume. So the dialog now says to
# skip the reboot, and "Keep testing" is the default button. Revert to the
# old wording if the bug ever comes back.
TITLE="Hibernation resume: don't reboot, we're testing the fix"
BODY="This session has been through a hibernation (${N} image$( [ "$N" -ne 1 ] && echo s) written this boot). \
Kernel $(uname -r) has the fix for the GPU-driver bug (drm/ttm bulk_move) that used to lock the machine up \
after this, and the fix needs hours of normal use after a resume to be confirmed. \
Choose Keep testing and carry on as usual. Save your work a little more often than normal. \
If the machine freezes or reboots by itself, that is the result we need: note the time."

# Critical-urgency notifications are not auto-dismissed by GNOME Shell and
# survive the lock screen, so this is visible right after unlocking.
notify-send -a hibernate-resume-warn -u critical -i dialog-information "$TITLE" "$BODY" 2>/dev/null || :

if command -v zenity >/dev/null 2>&1; then
    # OK = reboot, Cancel/Esc/close = keep testing, so dismissing it any other
    # way never reboots. --default-cancel puts the focus on "Keep testing".
    if zenity --question --title="$TITLE" --width=460 --icon=dialog-information --default-cancel \
              --text="<b>$TITLE</b>\n\n$BODY\n\nReboot only if you can't risk a freeze right now (an exam, a lecture)." \
              --ok-label="Reboot anyway" --cancel-label="Keep testing" 2>/dev/null; then
        systemctl reboot
    fi
else
    echo "$TITLE: $BODY"
fi
exit 0
