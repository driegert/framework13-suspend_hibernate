#!/bin/bash
# Check whether Ubuntu's kernel has picked up the drm/ttm fix for the
# hibernate-resume lockup (swapped-out TTM resources left in their bulk_move
# range; hits Framework 13 AMD on 7.0.0-28+). Looks at the running kernel and
# the apt candidate, and notifies when the fix shows up in either.
#
#   ttm-fix-check          # print status, notify on change
#   ttm-fix-check --quiet  # only speak up when the fix is present
set -u

FIX='fix swapped-out resources never leaving their bulk_move range'
BUG='Fix ttm_bo_swapout() infinite LRU walk'
PKG=linux-generic-hwe-26.04
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/ttm-fix-check
CACHE=$STATE_DIR/changelogs
mkdir -p "$CACHE"

QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1

# Ubuntu's changelog URLs use the source version, e.g. linux_7.0.0-31.31.
changelog_for() {              # $1 = ABI version like 7.0.0-31.31
    local f="$CACHE/$1.changelog"
    if [ ! -s "$f" ]; then
        curl -sfL --max-time 30 \
            "https://changelogs.ubuntu.com/changelogs/pool/main/l/linux/linux_$1/changelog" \
            -o "$f.tmp" && mv "$f.tmp" "$f" || { rm -f "$f.tmp"; return 1; }
    fi
    printf '%s' "$f"
}

status_of() {                  # prints: fixed | buggy | clean | unknown
    local f; f=$(changelog_for "$1") || { echo unknown; return; }
    if   grep -qF "$FIX" "$f"; then echo fixed
    elif grep -qF "$BUG" "$f"; then echo buggy
    else                            echo clean       # predates the bad commit
    fi
}

RUNNING=$(dpkg-query -W -f='${Version}' "linux-image-$(uname -r)" 2>/dev/null)
CANDIDATE=$(apt-cache policy "$PKG" | awk '/Candidate:/{print $2}')

RUN_ST=$(status_of "$RUNNING")
CAND_ST=$(status_of "$CANDIDATE")

if [ $QUIET -eq 0 ]; then
    printf 'running   %-14s %s\n' "$RUNNING"   "$RUN_ST"
    printf 'candidate %-14s %s\n' "$CANDIDATE" "$CAND_ST"
fi

# Notify once per (running,candidate,status) combination so a daily timer
# doesn't nag; a new kernel version resets it.
KEY="$RUNNING:$RUN_ST:$CANDIDATE:$CAND_ST"
LAST=$(cat "$STATE_DIR/last" 2>/dev/null || true)
notify() { notify-send -a ttm-fix-check -u "$1" "$2" "$3" 2>/dev/null; echo "$2 — $3"; }

if [ "$KEY" != "$LAST" ]; then
    if [ "$RUN_ST" = fixed ]; then
        notify normal "TTM hibernate fix is in the running kernel" \
            "$RUNNING contains '$FIX'. Hibernation before class is safe again."
    elif [ "$CAND_ST" = fixed ]; then
        notify critical "Kernel with the TTM hibernate fix is available" \
            "$PKG $CANDIDATE contains the fix; running $RUNNING does not. Upgrade and reboot."
    elif [ $QUIET -eq 0 ]; then
        echo "No fix yet — keep rebooting before class."
    fi
    printf '%s' "$KEY" > "$STATE_DIR/last"
elif [ $QUIET -eq 0 ]; then
    echo "No change since last check."
fi
